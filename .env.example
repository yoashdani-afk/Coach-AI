# Supabase — create a project at https://supabase.com/dashboard
# Optional for local dev preview — app runs without these in __DEV__ mode.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Analysis API — client reads resolved URL from src/lib/analysisConfig.ts only.
#
# LAN mode (Mac + iPhone on same Wi‑Fi, Expo started with --lan or default):
#   EXPO_PUBLIC_ANALYSIS_API_URL=http://YOUR_MAC_LAN_IP:3001
#   EXPO_PUBLIC_ANALYSIS_USE_PUBLIC_BACKEND=false
#
# Tunnel mode (Expo --tunnel; phone cannot reach Mac LAN IP):
#   1. Expose port 3001 with ngrok/cloudflared, e.g. https://abc123.ngrok-free.app
#   2. Set EXPO_PUBLIC_ANALYSIS_API_PUBLIC_URL to that HTTPS URL
#   3. Set EXPO_PUBLIC_ANALYSIS_USE_PUBLIC_BACKEND=true
#
# iOS Simulator only: http://localhost:3001
# Android Emulator only: http://10.0.2.2:3001
EXPO_PUBLIC_ANALYSIS_API_URL=http://YOUR_MAC_LAN_IP:3001
EXPO_PUBLIC_ANALYSIS_API_PUBLIC_URL=
EXPO_PUBLIC_ANALYSIS_USE_PUBLIC_BACKEND=false

# Tracking debug overlay (default off). Set true only when diagnosing coordinate issues.
# EXPO_PUBLIC_SHOW_TRACKING_DEBUG=true — set in server/.env, NEVER in this file or the mobile app.
# GEMINI_API_KEY=

# RevenueCat (native IAP only — not used on web)
# Create a project at https://app.revenuecat.com — entitlement id must be `pro`
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Optional: force Pro gates in __DEV__ without a purchase
# EXPO_PUBLIC_DEV_FORCE_PRO=1
