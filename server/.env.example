# Copy to server/.env — never commit real keys.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional — defaults shown
PORT=3001
# Analysis pipeline: dense_timeline (default) | legacy
ANALYSIS_PIPELINE=dense_timeline

# Optional override — must be a model returned by models.list for your API key.
# Leave unset to auto-discover the best available video-capable model.
# GEMINI_MODEL=

# Legacy full-video pipeline only (Files API). Does not affect dense_timeline.
# GEMINI_LEGACY_MODEL=gemini-pro-latest

# Max upload size in MB (short clips only in v1)
MAX_VIDEO_MB=80

# Tracking engine: botsort (YOLO + BoT-SORT via Python) | custom (legacy CV pipeline)
TRACKING_ENGINE=botsort

# Python BoT-SORT tracker service URL (run tracker_service/app.py)
TRACKER_SERVICE_URL=http://127.0.0.1:8765
